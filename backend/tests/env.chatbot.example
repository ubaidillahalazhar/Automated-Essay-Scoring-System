# ============================================================
# KONFIGURASI CHATBOT
# Tambahkan baris-baris ini ke backend/.env yang sudah ada.
# Cukup isi SALAH SATU API key. Yang terisi otomatis muncul
# sebagai pilihan model di widget chat.
# ============================================================

# --- API key (isi minimal satu) ---
# Gemini : https://aistudio.google.com/apikey     (ada free tier, tanpa kartu kredit)
# OpenAI : https://platform.openai.com/api-keys   (wajib isi saldo dulu)
# Claude : https://console.anthropic.com/settings/keys  (wajib isi saldo dulu)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Provider default saat user belum memilih ---
# Pilihan: gemini | openai | claude
CHAT_DEFAULT_PROVIDER=gemini

# --- Nama model (opsional) ---
# PENTING: nama model berubah cukup sering dan yang lama dipensiunkan.
# Kalau chatbot bilang "model tidak tersedia", cek daftar terbaru lalu isi di sini:
#   https://ai.google.dev/gemini-api/docs/models
#   https://platform.openai.com/docs/models
#   https://docs.claude.com/en/docs/about-claude/models
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5

# --- Batasan (opsional) ---
CHAT_TIMEOUT_MS=60000
CHAT_MAX_TOKENS=1024
